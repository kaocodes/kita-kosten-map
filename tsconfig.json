{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "rootDir": "web/src",
    "outDir": "build"
  },
  "include": ["web/src/domain/**/*.ts", "web/src/site/presentation.ts", "web/src/site/personal-profile.ts"]
}
